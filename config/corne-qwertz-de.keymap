// QWERTZ (German) layout for the corne, generated from the stock keymap.
// Layer 0 keys stay where they are (the computer's keyboard language decides what they type);
// the other layers type the same characters as the stock keymap. Extra keys:
//   layer 2, key 30: ü
//   layer 2, key 31: ß
//   layer 2, key 32: €
//   layer 2, key 33: ´
/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Wake-up key: top outer corner (Tab / \), row pin 4, column pin 21 on both halves.
#define TKL_WAKE_ROW 4
#define TKL_WAKE_COL 21
// Switch-off: Tab + Ctrl/Esc held together.
#define TKL_OFF_KEYS 0 24
#include "tkl_power.dtsi"
#include "tkl_brightness.dtsi"

/ {
    behaviors {
        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        capslock_layer1: capslock_layer1 {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPSLOCK_LAYER1";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp CAPSLOCK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mo_layer3 {
            bindings = <&mo 3>;
            key-positions = <37 38>;
        };

        layer-3-right {
            bindings = <&mo 3>;
            key-positions = <39 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E     &kp R             &kp T          &kp Y      &kp U          &kp I       &kp O    &kp P          &kp BACKSLASH
&kp LEFT_SHIFT    &kp A  &kp S  &kp D     &kp F             &kp G          &kp H      &kp J          &kp K       &kp L    &kp SEMICOLON  &kp SINGLE_QUOTE
&mt LCTRL ESCAPE  &kp Z  &kp X  &kp C     &kp V             &kp B          &kp N      &kp M          &kp COMMA   &kp DOT  &kp FSLH       &mt LEFT_ALT GRAVE
                                &kp LGUI  &capslock_layer1  &lt 2 ENTER    &kp SPACE  &kp BACKSPACE  &kp DELETE
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &kp N5              &kp NUMBER_6       &kp N7           &kp N8         &kp N9                &kp N0                 &none
&trans  &kp EXCLAMATION  &kp RA(Q)     &kp NON_US_HASH     &kp DOLLAR      &kp PERCENT         &kp GRAVE          &kp LS(N6)       &kp LS(RBKT)   &kp LS(N8)            &kp LS(N9)             &kp LS(NON_US_HASH)
&trans  &none            &kp KP_PLUS   &kp KP_MINUS  &kp RA(N7)      &kp RA(N8)          &kp RA(N9)         &kp RA(N0)       &none          &kp LS(N0)             &kp LS(FSLH)              &trans
                                       &trans        &trans          &trans              &trans             &trans           &kp RIGHT_ALT
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none     &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none  &none
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none     &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none  &none
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none     &kp LBKT     &kp MINUS          &kp RA(E)        &kp EQUAL      &none  &trans
                         &trans   &trans   &trans    &trans    &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&none       &none         &none         &none         &none         &none           &kp C_VOLUME_UP    &none  &none  &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp C_VOLUME_DOWN  &none  &none  &none  &none  &none
&none       &out OUT_USB  &out OUT_BLE  &scr_bri      &none         &none           &kp C_MUTE         &none  &none  &none  &none  &studio_unlock
                                        &none         &none         &none           &none              &none  &none
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
